{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src/",
        "lib": ["ESNext"],
        "strict": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "moduleResolution": "nodenext",
        "module": "nodenext",
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": ["src/**/*.ts"]
}